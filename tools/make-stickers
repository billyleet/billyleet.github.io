#!/usr/bin/env bash
# Regenerate the normalized sticker assets in stickers/.
#
#   tools/make-stickers
#
# Bootstraps the local .venv (gitignored) with Pillow on first run.
# Requires ImageMagick (magick) for the one SVG rasterization.
set -euo pipefail
cd "$(dirname "$0")/.."

VENV=.venv
if [ ! -x "$VENV/bin/python" ]; then
    echo "one-time setup: creating $VENV..."
    python3 -m venv "$VENV"
fi
"$VENV/bin/python" -c "import PIL" 2>/dev/null || "$VENV/bin/pip" install --quiet Pillow

command -v magick >/dev/null 2>&1 || {
    echo "error: ImageMagick (magick) is required to rasterize the Change.org SVG" >&2
    exit 1
}

exec "$VENV/bin/python" tools/make_stickers.py "$@"
