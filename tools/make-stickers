#!/usr/bin/env bash
# Regenerate the normalized sticker assets in stickers/.
#
#   tools/make-stickers
#
# Bootstraps the local .venv (gitignored) with Pillow + cairosvg on first
# run. cairosvg needs the cairo C library (brew install cairo); the
# DYLD fallback below lets it find the Homebrew copy on macOS.
set -euo pipefail
cd "$(dirname "$0")/.."

VENV=.venv
if [ ! -x "$VENV/bin/python" ]; then
    echo "one-time setup: creating $VENV..."
    python3 -m venv "$VENV"
fi
"$VENV/bin/python" -c "import PIL, cairosvg" 2>/dev/null || "$VENV/bin/pip" install --quiet Pillow cairosvg

export DYLD_FALLBACK_LIBRARY_PATH="/opt/homebrew/lib:${DYLD_FALLBACK_LIBRARY_PATH:-}"
exec "$VENV/bin/python" tools/make_stickers.py "$@"
